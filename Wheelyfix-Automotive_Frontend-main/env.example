# API Configuration
VITE_API_BASE_URL=http://localhost:5000

# Razorpay Configuration (Test Mode)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# App Configuration
VITE_APP_NAME=WheelyFix
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Your trusted automotive service partner

# Admin Panel Configuration
VITE_ADMIN_PANEL_URL=http://localhost:3000/admin

# Environment
VITE_NODE_ENV=development

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here
VITE_FACEBOOK_PIXEL_ID=your_pixel_id_here

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false

# Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/wheelyfix
VITE_TWITTER_URL=https://twitter.com/wheelyfix
VITE_INSTAGRAM_URL=https://instagram.com/wheelyfix
VITE_LINKEDIN_URL=https://linkedin.com/company/wheelyfix
VITE_YOUTUBE_URL=https://youtube.com/wheelyfix

# Contact Information
VITE_CONTACT_EMAIL=info@wheelyfix.in
VITE_CONTACT_PHONE=+91-9876543210
VITE_CONTACT_ADDRESS=123 Service Street, Mumbai, Maharashtra 400001

# Business Hours
VITE_BUSINESS_HOURS_MONDAY=9:00 AM - 6:00 PM
VITE_BUSINESS_HOURS_TUESDAY=9:00 AM - 6:00 PM
VITE_BUSINESS_HOURS_WEDNESDAY=9:00 AM - 6:00 PM
VITE_BUSINESS_HOURS_THURSDAY=9:00 AM - 6:00 PM
VITE_BUSINESS_HOURS_FRIDAY=9:00 AM - 6:00 PM
VITE_BUSINESS_HOURS_SATURDAY=9:00 AM - 4:00 PM
VITE_BUSINESS_HOURS_SUNDAY=10:00 AM - 2:00 PM
