# Environment Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/wheelyfix

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here_make_it_long_and_random
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM_NAME=WheelyFix
EMAIL_FROM_ADDRESS=noreply@wheelyfix.in

# File Upload Configuration
UPLOAD_PATH=./public/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=86400000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# AWS S3 Configuration (Optional - for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=wheelyfix-uploads

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here
NEW_RELIC_LICENSE_KEY=your_new_relic_key_here

# Admin Panel Configuration
ADMIN_PANEL_URL=http://localhost:3000/admin
FRONTEND_URL=http://localhost:3000
# Optional: default admin credentials used by the createAdmin/seed scripts
# Set these in your .env (do NOT commit .env to version control)
ADMIN_EMAIL=admin@wheelyfix.com
ADMIN_PASSWORD=Admin123!
SUPERADMIN_EMAIL=superadmin@wheelyfix.com
SUPERADMIN_PASSWORD=ChangeMe123!
MANAGER_EMAIL=manager@wheelyfix.com
MANAGER_PASSWORD=Manager123!

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_GUEST_CHECKOUT=true
ENABLE_WISHLIST=true
ENABLE_REVIEWS=true
ENABLE_NOTIFICATIONS=true

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Site is under maintenance. Please check back later.

# API Configuration
API_VERSION=v1
API_PREFIX=/api
ADMIN_API_PREFIX=/api/admin

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_ITEMS=1000